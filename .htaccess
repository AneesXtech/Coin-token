# ─────────────────────────────────────────────────────────────
# HouseFacts Production Config (GoDaddy / cPanel / Apache)
# ─────────────────────────────────────────────────────────────

# 1. Prevent Directory Browsing
Options -Indexes

# 2. Set Default Encoding
AddDefaultCharset UTF-8

# 3. MIME Types (Ensures .hdr 3D reflections & assets load correctly)
<IfModule mod_mime.c>
    AddType application/octet-stream .hdr
    AddType image/png .png
    AddType image/x-icon .ico
    AddType text/css .css
    AddType application/javascript .js
</IfModule>

# 4. Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# 5. Browser Caching for Fast Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 6. Basic Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
